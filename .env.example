# Copy this file to `.env` and fill in a real value:
#   cp .env.example .env
#
# Docker Compose automatically loads `.env` (next to docker-compose.yml) and
# substitutes it into ${SITE_PASSWORD} in the production compose file.
# The real `.env` is git-ignored; this example is safe to commit.

# Shared password for the private scrapbook boards. It's also the key that rides
# in share links (/scrapbook?key=...), so prefer a memorable passphrase over a
# reused password. Changing it logs everyone out and invalidates old links.
SITE_PASSWORD=change-me
